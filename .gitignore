# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
build_debug.log

# Backups
# `.backup` copies are written next to each data file by
# scripts/update-conditions.js as an in-run safety net before overwriting.
# They must never be committed: git history is already the backup, and
# tracking them rewrote ~17 MB across 186 files on every bot data commit
# (~15/day). Note `*.bak` alone did NOT match them — hence the explicit
# `*.backup`. (scripts/restore-data.js uses the separate `.backup/` dir.)
*.bak
*.backup

# IDE / local agent scratch
.vscode/
.idea/
.claude/
.freebuff/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
*.tsbuildinfo

# Local one-off debug scripts (never commit)
scripts/probe-*
scripts/extract-*
scripts/find-jwt-*
_axe*.cjs

# Local Lighthouse audit reports (run against prod: serve out/ then npx lighthouse)
lighthouse-*.json

# Local audit screenshots (never commit)
audit-screenshots/
.screenshots/
conditions-update.log

# Testing
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OG spot share cards — generated at build (npm run og:generate)
public/images/og/

# Auto-generated data files (updated by GitHub Actions)
# Keep the directory structure but ignore contents
public/data/
# Exception: keep .gitkeep to preserve directory
!public/data/.gitkeep
# Community tips overlay (merged from approved contributions)
!public/data/community-tips.json
# Schools/shops directory seed (regenerate with npm run directory:fetch)
!public/data/directory.json
# Curated community events (hand-edited; see docs/EVENTS.md)
!public/data/events.json
# Precomputed scores index (regenerate with npm run spots:index)
!public/data/spots-index.json
# IPMA station nearest-spot map (regenerate with npm run obs:map)
!public/data/ipma-station-map.json
!public/data/ipma-station-map.meta.json

# Terraform (S7 — Cloudflare ruleset; nunca commitar state/tfvars)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars

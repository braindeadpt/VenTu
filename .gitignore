# OG spot share cards — generated at build (npm run og:generate)
public/images/og/

# Auto-generated data files (updated by GitHub Actions)
# Keep the directory structure but ignore contents
public/data/
# Exception: keep .gitkeep to preserve directory
!public/data/.gitkeep
# Community tips overlay (merged from approved contributions)
!public/data/community-tips.json
# Schools/shops directory seed (regenerate with npm run directory:fetch)
!public/data/directory.json
# Curated community events (hand-edited; see docs/EVENTS.md)
!public/data/events.json
# Precomputed scores index (regenerate with npm run spots:index)
!public/data/spots-index.json
# IPMA station nearest-spot map (regenerate with npm run obs:map)
!public/data/ipma-station-map.json
!public/data/ipma-station-map.meta.json

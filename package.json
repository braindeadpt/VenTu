{
  "name": "ventu",
  "version": "1.0.0",
  "description": "Open-source surf and water-sports conditions for Portugal (185 spots, live cams, scores, forecasts)",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/braindeadpt/VenTu.git"
  },
  "homepage": "https://ventu.surf",
  "scripts": {
    "dev": "next dev",
    "build": "npm run og:generate && npm run spots:lite && next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test full-audit",
    "test:e2e:ux": "playwright test visual-ux-audit",
    "test:e2e:core": "playwright test home-adaptive mapa-route spot-dashboard confidence-badge",
    "lighthouse:prod": "node scripts/run-lighthouse-prod.js",
    "audit:full": "node scripts/run-full-audit.js",
    "audit:ux": "node scripts/run-ux-audit.js",
    "test:prod-check": "node scripts/prod-manual-check.js",
    "audit:install": "playwright install chromium",
    "news:generate": "node scripts/update-news.js",
    "news:probe-feeds": "node scripts/news/probe-feeds.js",
    "conditions:update": "node scripts/update-conditions.js",
    "obs:map": "node scripts/build-station-map.mjs",
    "obs:update": "node scripts/build-station-map.mjs && node scripts/merge-observations.mjs",
    "wind:validate": "node scripts/validate-coastal-wind.mjs",
    "update-ecowitt": "node scripts/update-ecowitt.mjs",
    "data:update": "npm run conditions:update && npm run obs:update && npm run spots:index && npm run spots:lite && npm run news:generate",
    "spots:index": "tsx scripts/build-spots-index-ts.ts",
    "spots:lite": "tsx scripts/generate-spots-lite.ts",
    "spots:aerials": "node scripts/generate-spot-aerials.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "og:generate": "node scripts/generate-og-image.mjs && node scripts/generate-spot-og-images.mjs",
    "spots:validate": "node scripts/validate-spots.js",
    "alerts:evaluate": "node scripts/evaluate-alerts.js",
    "alerts:preflight": "node scripts/alerts-preflight.js",
    "telegram:poll": "node scripts/telegram-poll.js",
    "directory:fetch": "tsx scripts/directory/fetch-osm.ts",
    "directory:aesp": "tsx scripts/directory/build-aesp-seed.ts",
    "directory:validate": "tsx scripts/directory/validate.ts",
    "events:validate": "tsx scripts/events/validate.ts",
    "contributions:apply": "node scripts/apply-contributions.js",
    "scores:analyze": "node scripts/analyze-score-feedback.js",
    "dawn-patrol:generate": "node scripts/dawn-patrol.js",
    "dawn-patrol:dev": "node -e \"require('dotenv').config()\" && node scripts/dawn-patrol.js",
    "data:restore": "node scripts/restore-data.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "geist": "^1.7.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.469.0",
    "next": "^16.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}

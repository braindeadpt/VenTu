{
  "name": "ventu",
  "version": "1.0.0",
  "description": "Open-source surf and water-sports conditions for Portugal (185 spots, live cams, scores, forecasts)",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/braindeadpt/VenTu.git"
  },
  "homepage": "https://ventu.surf",
  "scripts": {
    "dev": "next dev",
    "build": "npm run og:generate && npm run spots:lite && next build && node scripts/fixup-next-segment-paths.js",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:audit": "playwright test full-audit",
    "test:e2e:ux": "playwright test visual-ux-audit",
    "test:e2e:axe": "playwright test axe-audit",
    "test:e2e:core": "playwright test home-adaptive mapa-route spot-dashboard confidence-badge observed-wave-card mar-perigoso isobaths buoy-warnings tides topnow-wave-badge coastal-nav-warnings data-sources coastal-map-layer spot-sticky-geometry tools-calculators mobile-playtest",
    "test:e2e:data": "playwright test tides buoy-warnings topnow-wave-badge",
    "test:supabase": "bash supabase/tests/run-tests.sh",
    "check:headers": "bash scripts/check-security-headers.sh",
    "terraform:expressions": "node scripts/validate-terraform-expressions.js",
    "ih:validate": "node scripts/validate-ih-edr-schema.js",
    "lighthouse:prod": "node scripts/run-lighthouse-prod.js",
    "audit:full": "node scripts/run-full-audit.js",
    "audit:ux": "node scripts/run-ux-audit.js",
    "release:health": "node scripts/release-health-check.js",
    "test:prod-check": "node scripts/prod-manual-check.js",
    "audit:install": "playwright install chromium",
    "news:generate": "node scripts/update-news.js",
    "news:probe-feeds": "node scripts/news/probe-feeds.js",
    "conditions:update": "node scripts/update-conditions.js",
    "models:health": "node scripts/check-model-health.js",
    "buoys:fetch": "node scripts/fetch-ih-buoys.js",
    "isobaths:fetch": "node scripts/fetch-ih-isobaths.js",
    "buoys:test-key": "node scripts/buoys-test-key.js",
    "ecowitt:test-key": "node scripts/test-ecowitt-api-key.js",
    "alerts:test-key": "node scripts/alerts-test-key.js",
    "resend:test-key": "node scripts/test-resend-api-key.js",
    "wmo:fetch": "node scripts/fetch-copernicus-buoys.js",
    "bias:fetch": "node scripts/fetch-wave-bias.js",
    "skill:fetch": "node scripts/fetch-forecast-skill.js",
    "smoke:es": "node scripts/smoke-es-pipeline.js",
    "obs:coherence": "node scripts/check-buoy-coherence.js",
    "warnings:fetch": "node scripts/fetch-ipma-warnings.js",
    "warnings:nav": "node scripts/fetch-ih-coastal-warnings.js",
    "warnings:meteoalarm": "node scripts/fetch-meteoalarm-warnings.js",
    "warnings:test-key": "node scripts/test-meteoalarm-api-key.js",
    "radar:fetch": "node scripts/fetch-ipma-radar.js",
    "obs:map": "node scripts/build-station-map.mjs",
    "obs:update": "node scripts/build-station-map.mjs && node scripts/merge-observations.mjs",
    "wind:validate": "node scripts/validate-coastal-wind.mjs",
    "update-ecowitt": "node scripts/update-ecowitt.mjs",
    "data:update": "npm run buoys:fetch && npm run isobaths:fetch && npm run wmo:fetch && npm run bias:fetch && npm run conditions:update && npm run obs:update && npm run radar:fetch && npm run warnings:fetch && npm run warnings:nav && npm run spots:index && npm run spots:lite && npm run news:generate",
    "spots:index": "tsx scripts/build-spots-index-ts.ts",
    "spots:lite": "tsx scripts/generate-spots-lite.ts",
    "spots:aerials": "node scripts/generate-spot-aerials.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "og:generate": "node scripts/generate-og-image.mjs && node scripts/generate-spot-og-images.mjs",
    "spots:validate": "node scripts/validate-spots.js",
    "pages:validate": "node scripts/validate-page-slugs.js",
    "news:validate-slugs": "node scripts/validate-news-livecams.js",
    "test:guard-counts": "node scripts/check-guard-test-counts.js",
    "data:validate": "node scripts/validate-data-files.js",
    "scan:encoding": "node scripts/scan-history-encoding.js",
    "alerts:evaluate": "node scripts/evaluate-alerts.js",
    "alerts:preflight": "node scripts/alerts-preflight.js",
    "telegram:poll": "node scripts/telegram-poll.js",
    "directory:fetch": "tsx scripts/directory/fetch-osm.ts",
    "directory:aesp": "tsx scripts/directory/build-aesp-seed.ts",
    "directory:validate": "tsx scripts/directory/validate.ts",
    "events:validate": "tsx scripts/events/validate.ts",
    "contributions:apply": "node scripts/apply-contributions.js",
    "scores:analyze": "node scripts/analyze-score-feedback.js",
    "dawn-patrol:generate": "node scripts/dawn-patrol.js",
    "dawn-patrol:dev": "node -e \"require('dotenv').config()\" && node scripts/dawn-patrol.js",
    "data:restore": "node scripts/restore-data.js",
    "skill:regression": "node scripts/check-skill-regression.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "geist": "^1.7.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.469.0",
    "next": "^16.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "h5wasm": "^0.10.3",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}

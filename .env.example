# VenTu Environment Variables

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (feedback form + admin contributions)
# Get these from your Supabase project dashboard: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# LLM fallback chain: Gemini → Groq → Cerebras (news + dawn patrol)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=
CEREBRAS_API_KEY=

# News: set to 1 to use LLM for event story synthesis (default: factual copy only)
NEWS_LLM_SYNTHESIS=

# GoatCounter analytics (privacy-first, no cookies)
# Set this to your subdomain (e.g., "ventu" → ventu.goatcounter.com)
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Live observations (Cloudflare Worker — public URL only; Ecowitt keys stay on the worker)
# GitHub: Settings → Secrets and variables → Actions → Variables
NEXT_PUBLIC_OBS_WORKER_URL=https://ventu-observations.busntech-net.workers.dev

# Ecowitt PWS (baked observed layer in CI — optional; GitHub Secrets)
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Resend (email alerts — Phase C2)
# Get API key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM=VenTu <alerts@ventu.surf>

# Telegram alerts (account linking + alerts on /conta)
# Bot token from BotFather: https://t.me/BotFather (GitHub secret TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_TOKEN=
# Public bot username WITHOUT the @ (GitHub var/secret NEXT_PUBLIC_TELEGRAM_BOT_USERNAME)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Supabase service role (CI only — NEVER expose as NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Setup:
# 1. Create a Supabase project at https://supabase.com
# 2. Run supabase/supabase-contributions.sql in the SQL Editor
# 3. Run supabase/supabase-score-feedback.sql and supabase/supabase-alerts.sql
# 4. Run supabase/supabase-contributions-migration-c3.sql if contributions table exists
# 3. Create an admin user: Authentication → Users → Add user (email + password)
# 4. Admin panel: /pt/admin/contributions/ (not linked in public nav)
# 5. Copy URL + anon key to .env.local

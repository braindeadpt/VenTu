# VenTu Environment Variables

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (feedback form + admin contributions)
# Get these from your Supabase project dashboard: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# LLM fallback chain: Gemini → Groq → Cerebras (news + dawn patrol)
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=
CEREBRAS_API_KEY=

# News: set to 1 to use LLM for event story synthesis (default: factual copy only)
NEWS_LLM_SYNTHESIS=

# GoatCounter analytics (privacy-first, no cookies)
# Set this to your subdomain (e.g., "ventu" → ventu.goatcounter.com)
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Live observations (Cloudflare Worker — public URL only; Ecowitt keys stay on the worker)
# GitHub: Settings → Secrets and variables → Actions → Variables
NEXT_PUBLIC_OBS_WORKER_URL=https://ventu-observations.busntech-net.workers.dev

# Ecowitt PWS (baked observed layer in CI — optional; GitHub Secrets)
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# IH Datawell Waverider buoys (measured wave height/period/direction — optional)
# Free API key (X-API-KEY header) — request it by email: cedencia.dados@hidrografico.pt
# Full guide (key request + GitHub secret + end-to-end test): docs/IH_API_KEY.md
# Without it, fetch-ih-buoys.js still writes buoy stations but no wave series.
IH_API_KEY=

# MeteoGate warnings — FALLBACK quando o IPMA está em baixo (optional)
# Particulars: API key from https://devportal.meteogate.eu (not api.meteoalarm.org)
# Guide: docs/METEOALARM_API_KEY.md
METEOGATE_API_KEY=
# Direct EDR Bearer — only for approved re-users (ignored if METEOGATE_API_KEY is set)
METEOALARM_API_KEY=

# Copernicus Marine WMO buoys — observedWave FALLBACK (keyless, no setup needed)
# Same-class buoys (PT Datawell 6201077/79 + Puertos del Estado ES 6200024/25,
# 6200083-85) served via the Copernicus S3 bucket. Merge order: IH first,
# WMO fallback (gate 6h vs 3h). Override only for local dev/testing:
# WMO_BUOY_OUTPUT_PATH=/tmp/wmo-buoys.json

# Regional wave bias correction (Open-Meteo vs IH buoys, wave-bias.json)
# 1 = apply per-region bias to waveHeight in update-conditions (guards: N>=30,
# |ME|>=0.15 m, clamp >=0.1 m). Validate against the observed-wave card before
# enabling in production. GitHub: Settings → Secrets and variables → Actions → Variables
VENTU_WAVE_BIAS_CORRECTION=

# Ops alerts (optional) — Telegram chat where pipeline health notifications go
# (e.g. dead Open-Meteo ensemble models detected by scripts/lib/modelHealth.js).
# Create a private group/bot via BotFather and paste the chat id. Without it,
# the health check logs a dry-run and never sends.
OPS_TELEGRAM_CHAT_ID=

# Resend (email alerts — Phase C2)
# Get API key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM=VenTu <alerts@ventu.surf>

# Telegram alerts (account linking + alerts on /conta)
# Bot token from BotFather: https://t.me/BotFather (GitHub secret TELEGRAM_BOT_TOKEN)
TELEGRAM_BOT_TOKEN=
# Public bot username WITHOUT the @ (GitHub var/secret NEXT_PUBLIC_TELEGRAM_BOT_USERNAME)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Supabase service role (CI only — NEVER expose as NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Setup:
# 1. Create a Supabase project at https://supabase.com
# 2. Run supabase/supabase-contributions.sql in the SQL Editor
# 3. Run supabase/supabase-score-feedback.sql and supabase/supabase-alerts.sql
# 4. Run supabase/supabase-contributions-migration-c3.sql if contributions table exists
# 3. Create an admin user: Authentication → Users → Add user (email + password)
# 4. Admin panel: /pt/admin/contributions/ (not linked in public nav)
# 5. Copy URL + anon key to .env.local
